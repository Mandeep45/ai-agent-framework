OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# App
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# API auth (optional in dev; required in production)
API_KEY=

# Frontend (optional in dev; required for production static build)
# VITE_API_URL=http://localhost:3001
# VITE_API_KEY=your-api-key-here

# Database
# Leave DATABASE_URL empty to use SQLite locally.
DATABASE_PATH=data/app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/order_assistant
# DATABASE_SSL=true

# MCP (auto-configured for dev vs production)
# MCP_SERVER_COMMAND=tsx
# MCP_SERVER_PATH=src/mcp/server.ts

# Agent
AGENT_MAX_TURNS=10
AGENT_RUN_TIMEOUT_MS=60000
MCP_SERVER_TIMEOUT_MS=15000
