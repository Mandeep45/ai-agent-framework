{
  "name": "ai-agent-framework",
  "version": "1.0.0",
  "description": "A from-scratch AI Agent framework built with Node.js and TypeScript",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "predev:api": "tsx scripts/free-port.ts 3001",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "predev:web": "tsx scripts/free-port.ts 5173",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "predev:app": "tsx scripts/free-port.ts 3001 && tsx scripts/free-port.ts 5173",
    "dev:app": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:app": "npm run build && npm run build:web",
    "start:api": "cross-env NODE_ENV=production node dist/apps/api/src/server.js",
    "start:prod": "npm run start:api",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "langgraph": "tsx src/langgraph/index.ts",
    "langgraph:approval": "tsx src/langgraph/approvalIndex.ts",
    "mcp": "tsx src/mcp/client.ts",
    "mcp:agent": "tsx src/mcp/agentIndex.ts",
    "agents-sdk": "tsx src/agents-sdk/index.ts",
    "agents-sdk:mcp": "tsx src/agents-sdk/mcpAgentIndex.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openai/agents": "^0.17.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
